---
import { site } from '../config';
import RecordingPreview from './RecordingPreview.astro';
---

<section class="relative isolate overflow-hidden border-b border-border-soft py-24 lg:py-36">
  <!-- Radial glow -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute left-1/2 top-[-240px] h-[560px] w-[960px] -translate-x-1/2
      bg-[radial-gradient(ellipse_at_center,rgba(131,144,250,0.10),transparent_70%)]"
  >
  </div>

  <div
    class="relative isolate mx-auto grid max-w-[1320px] grid-cols-1 items-center gap-14 px-8 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20 xl:gap-24"
  >
    <!-- Left: copy -->
    <div>
      <h1 class="mb-5 text-display-1 font-medium text-balance lg:max-w-[14em]">
        Self-hosted <span class="text-primary">Twitch VOD recorder</span>.
      </h1>

      <p class="mb-7 max-w-[520px] text-[19px] leading-[1.55] text-fg">
        Twitch deletes VODs after 14 days. ReplayVOD records the source stream to your disk so they don't
        disappear. One container, embedded SQLite, runs on a Pi 5.
      </p>

      <div class="mb-7 flex flex-wrap items-center gap-3">
        <a href="#install" class="btn btn-primary btn-lg">Read the install →</a>
        <a href={site.github} class="btn btn-lg" target="_blank" rel="noopener noreferrer">View on GitHub</a>
      </div>

      <div class="flex flex-wrap gap-x-[22px] gap-y-2 font-mono text-[13px] text-fg-muted">
        <span>GPLv3</span>
        <span>zero telemetry</span>
        <span>amd64 · arm64</span>
        <span>SQLite or Postgres</span>
      </div>
    </div>

    <RecordingPreview />
  </div>
</section>
