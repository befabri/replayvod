---
import { channels } from '../demo-channels';

// Seconds on the clock at first paint (02:14:32). The client script counts up from here.
const START_SECONDS = 8072;

const pad = (n: number) => String(n).padStart(2, '0');
const clock = (s: number) =>
  `${pad(Math.floor(s / 3600) % 24)}:${pad(Math.floor(s / 60) % 60)}:${pad(s % 60)}`;

// Finite work, so unlike the live recording these carry a percentage and an ETA.
const queued = [
  { label: `remux · ${channels.gaming}`, pct: 91, eta: '00:03' },
  { label: `remux · ${channels.creative}`, pct: 34, eta: '00:11' },
];

// Logged events keep the time they happened, so these stay put while the clock runs.
const LOG_AT = 52200;
const log = [
  { at: LOG_AT, tag: 'eventsub', msg: `stream.online · ${channels.creative}`, color: '#8390fa' },
  {
    at: LOG_AT - 47,
    tag: 'recorder',
    msg: `job start · 1080p60 · ${channels.development}`,
    color: '#a6da95',
  },
  { at: LOG_AT - 94, tag: 'scheduler', msg: 'rule match · viewers > 400', color: '#b7bdf8' },
];
---

<section data-reveal class="border-b border-border-soft py-32">
  <div class="mx-auto grid max-w-[1320px] grid-cols-1 items-center gap-20 px-8 lg:grid-cols-2">
    <!-- Text -->
    <div>
      <h3 class="mb-4 text-[34px] leading-[1.15] tracking-[-0.02em]">
        Live status, <span class="text-primary">not log diving</span>.
      </h3>
      <p class="mb-6 text-[17.5px] leading-[1.6] text-fg">
        The dashboard shows current channel status, active jobs with progress and ETA, and a tagged event log.
      </p>
      <ul class="m-0 list-none p-0">
        {
          [
            {
              label: 'stream.status SSE feed',
              detail:
                'Followed channels go live → row turns purple within a second of the EventSub callback.',
            },
            {
              label: 'Per-job progress',
              detail:
                'Stage (downloading / remuxing / finalizing), bytes written, MB/s, ETA, percent complete.',
            },
            {
              label: 'Tagged event log',
              detail:
                'recorder, eventsub, scheduler, remuxer, storage. Filterable. Persisted to the same DB.',
            },
          ].map((item, i, arr) => (
            <li
              class:list={[
                'flex gap-3 items-start py-2.5',
                i < arr.length - 1 && 'border-b border-border-soft',
              ]}
            >
              <span class="mt-px flex-none text-primary">→</span>
              <div>
                <strong class="text-[17px] text-fg">{item.label}</strong>
                <small class="mt-0.5 block text-[15.5px] text-fg-muted">{item.detail}</small>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Clock + log. Flat Catppuccin-Macchiato palette matched to the install terminal.
         A live recording has no end time, so it gets an open-ended bar with elapsed and
         bytes and never a percentage; only the queued remux shows a percentage and ETA. -->
    <live-status-panel
      data-start={START_SECONDS}
      role="img"
      aria-label={`Sample recording panel: ${channels.development} has been recording for two hours, 8.4 gigabytes written at 22.1 megabytes per second, with two queued remux jobs at 91 and 34 percent and three tagged log lines from eventsub, recorder and scheduler.`}
      class="block rounded-xl border border-[#2a2740] bg-[#1c1a2e] px-6 pt-[26px] pb-[22px] shadow-[0_18px_44px_rgba(0,0,0,0.35)]"
    >
      <div class="mb-3 flex items-baseline gap-[9px] font-mono text-[12.5px]">
        <span class="text-primary">recording</span>
        <span class="text-[#3b3a5c]">→</span>
        <span class="text-[#5b5b7a]">remux</span>
        <span class="text-[#3b3a5c]">→</span>
        <span class="text-[#5b5b7a]">finalize</span>
      </div>

      <div class="mb-4 flex items-end justify-between gap-4">
        <div
          data-clock
          class="font-heading text-[38px] leading-none font-medium tracking-[-0.03em] tabular-nums"
        >
          {clock(START_SECONDS)}
        </div>
        <div class="text-right font-mono text-[12px] leading-[1.7] text-[#8c8fa1]">
          <div class="text-fg">8.4 GB</div>
          <div>22.1 MB/s</div>
        </div>
      </div>

      <div class="relative h-2 overflow-hidden rounded-[4px] bg-[#15131f]">
        <span
          class="absolute inset-0 bg-[linear-gradient(90deg,var(--color-primary),rgba(131,144,250,0.85)_62%,rgba(131,144,250,0.12))]"
        ></span>
        <span
          data-sweep
          class="absolute inset-y-0 w-1/4 bg-[linear-gradient(90deg,transparent,rgba(204,204,228,0.22),transparent)]"
        ></span>
      </div>
      <div class="mt-2.5 flex gap-4 font-mono text-[11.5px] text-[#8c8fa1]">
        <span>1080p60</span>
        <span>→ /recordings</span>
        <span class="ml-auto text-[#7a7c98]">runs until the stream ends</span>
      </div>

      <div class="mt-4 flex flex-col gap-2.5 border-t border-[#2a2740] pt-4 font-mono text-[11.5px]">
        {
          queued.map((job) => (
            <div class="flex items-center gap-3">
              <span class="min-w-[140px] whitespace-nowrap text-[#b7bdf8]">{job.label}</span>
              <span class="relative h-1.5 flex-1 overflow-hidden rounded-[3px] bg-[#15131f]">
                <span
                  class="absolute inset-y-0 left-0 rounded-[3px] bg-[#b7bdf8]"
                  style={`width: ${job.pct}%`}
                />
              </span>
              <span class="min-w-[104px] text-right text-[#8c8fa1] tabular-nums">
                {job.pct}% · eta {job.eta}
              </span>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-col gap-2 border-t border-[#2a2740] pt-4">
        {
          log.map((line) => (
            <div class="grid grid-cols-[58px_76px_1fr] items-baseline gap-2.5 font-mono text-[12px]">
              <span class="text-[#5b5b7a] tabular-nums">{clock(line.at)}</span>
              <span style={`color: ${line.color}`}>{line.tag}</span>
              <span class="truncate text-[#8c8fa1]">{line.msg}</span>
            </div>
          ))
        }
      </div>
    </live-status-panel>
  </div>
</section>

<style>
  @keyframes rv-sweep {
    from {
      transform: translateX(-120%);
    }
    to {
      transform: translateX(420%);
    }
  }

  [data-sweep] {
    animation: rv-sweep 2.6s linear infinite;
  }

  live-status-panel[data-paused='true'] [data-sweep] {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-sweep] {
      animation: none;
      opacity: 0;
    }
  }
</style>

<script>
  class LiveStatusPanel extends HTMLElement {
    private events?: AbortController;
    private timer?: number;

    connectedCallback() {
      this.events?.abort();
      this.events = new AbortController();
      const { signal } = this.events;
      const clockEl = this.querySelector<HTMLElement>('[data-clock]');
      if (!clockEl) return;

      const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let elapsed = Number(this.dataset.start ?? 0);
      let offscreen = false;

      const pad = (n: number) => String(n).padStart(2, '0');
      const tick = () => {
        elapsed += 1;
        clockEl.textContent = `${pad(Math.floor(elapsed / 3600) % 24)}:${pad(
          Math.floor(elapsed / 60) % 60,
        )}:${pad(elapsed % 60)}`;
      };

      const sync = () => {
        const paused = motion.matches || offscreen || document.hidden;
        this.dataset.paused = String(paused);
        if (paused) {
          clearInterval(this.timer);
          this.timer = undefined;
          return;
        }
        this.timer ??= window.setInterval(tick, 1000);
      };

      const observer = new IntersectionObserver(([entry]) => {
        offscreen = !entry.isIntersecting;
        sync();
      });
      observer.observe(this);
      signal.addEventListener('abort', () => observer.disconnect(), { once: true });
      document.addEventListener('visibilitychange', sync, { signal });
      motion.addEventListener('change', sync, { signal });
      sync();
    }

    disconnectedCallback() {
      clearInterval(this.timer);
      this.timer = undefined;
      this.events?.abort();
    }
  }
  if (!customElements.get('live-status-panel')) customElements.define('live-status-panel', LiveStatusPanel);
</script>
